{
  "name": "evidence-ai-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "React front end for Evidence AI. Builds to static files that the FastAPI process serves at /ui, so a deployment exposes one port.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:render": "esbuild ssr_smoke.jsx --bundle --platform=node --format=cjs --outfile=node_modules/.ssr_smoke.cjs --loader:.jsx=jsx --jsx=automatic --log-level=warning && node node_modules/.ssr_smoke.cjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}
