# ============================================================
# INFERENCE MODE
# ============================================================
# "offline" -> local Ollama (no internet needed at runtime)
# "online"  -> cloud API (no Ollama needed)
# This is only the mode the UI starts on; you can switch at runtime.
INFERENCE_BACKEND=offline

# ============================================================
# ONLINE (CLOUD) INFERENCE
# ============================================================
# Required ONLY for Online mode. Leave blank to run Offline only.
# NEVER commit a real key. This file holds placeholders only.
OPENAI_API_KEY=

# Any OpenAI-compatible endpoint works (OpenAI, Azure OpenAI, OpenRouter,
# a self-hosted gateway) without code changes.
ONLINE_MODEL=gpt-4o-mini
ONLINE_BASE_URL=https://api.openai.com/v1
ONLINE_TIMEOUT=120
# Set false if your online model has no vision support.
ONLINE_MODEL_SUPPORTS_VISION=true
# Name of the environment variable that holds the online API key. Named in
# user-facing setup messages so it is obvious what to set; the key itself is
# never written to disk or printed by this project.
ONLINE_API_KEY_ENV=OPENAI_API_KEY

# Evidence AI configuration. Copy to .env and edit as needed.
# Every value here has a working default in config.py.

# ---- Local LLM (Ollama) ----
OLLAMA_HOST=http://localhost:11434
# The demo kit ships with the small CPU model: 400 MB, runs anywhere, and every
# number quoted in DEMO_RUNBOOK.md was measured with it. It is text-only, so an
# image is indexed by OCR (Tesseract) and falls back to that when vision input is
# refused. For real image understanding on a GPU with 4 GB+ VRAM, use the vision
# model instead and re-ingest: OLLAMA_MODEL=qwen2.5vl:3b
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_TIMEOUT=300
# Keeps the model resident between queries (default 5m costs a ~14s reload).
OLLAMA_KEEP_ALIVE=30m
# One image costs ~1030 prompt tokens; 4096 leaves too little for evidence.
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.0
# Hard cap on generated tokens. Without it a small local model can enter a
# repetition loop and generate until the request times out (measured: an
# uncapped answer ran past the 300 s client timeout while the server kept
# going). Every answer this system produces is far shorter than 512 tokens.
OLLAMA_NUM_PREDICT=512

# ---- Local models ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# GPU is reserved for Ollama; PyTorch stays on CPU.
TORCH_DEVICE=cpu

# ---- Chunking ----
CHUNK_SIZE=800
# fixed = character window with overlap (the default, and what the published
# evaluation baseline was measured against). structure = headings, paragraphs and
# table rows, with the heading path kept on every chunk (chunking.py). Changing
# this changes how every document splits: run scripts\reindex.py afterwards.
CHUNKING_MODE=fixed
CHUNK_OVERLAP=100
# A fragment shorter than this is merged into its neighbour rather than indexed
# alone: it carries a heading but not the sentence that answers anything.
MIN_CHUNK_CHARS=40
# Floor used by CHUNKING_MODE=structure, where blocks follow headings, slides,
# table rows and transcript segments. 40 was measured to be too small there -
# a title slide split into 63 fragments and the model invented an affiliation
# for one of them. 200 gave 30 blocks with a 290-character median.
STRUCTURE_MIN_CHUNK_CHARS=200

# ---- Retrieval ----
TOP_K=10
RERANK_TOP_K=5

# ---- Relationships ----
RELATED_TO_THRESHOLD=0.70
MAX_RELATIONSHIP_EXPANSION=3

# ---- Generation context ----
MAX_CONTEXT_ITEMS=5
MAX_CONTEXT_CHARS=6000
# How much of each item is shown as an excerpt in the UI and in citations.
MAX_EXCERPT_CHARS=400
MAX_INSPECT_IMAGES=1

# ---- Determinism ----
# Fixed seed = reproducible answers and comparable evaluation reports.
# Set to 0 (or below) to let the server sample freely.
OLLAMA_SEED=42

# ---- Retrieval quality ----
# Hybrid = dense embeddings fused with BM25 via reciprocal rank fusion.
HYBRID_ENABLED=true
HYBRID_RRF_K=60
HYBRID_LEXICAL_K=20
# The cross-encoder mildly prefers long chunks; these penalise them back.
RERANK_LENGTH_NORM=true
RERANK_LENGTH_THRESHOLD_CHARS=600
RERANK_LENGTH_PENALTY=0.2
# Diversity re-selection. The per-source cap stops one document crowding out
# other modalities (measured: without it, cross-modal recall fell .958 -> .875).
MMR_ENABLED=true
MMR_LAMBDA=0.7
MMR_MAX_PER_SOURCE=2
# In structure mode blocks are smaller and several of them legitimately come
# from different sections of the same file, so the cap is relaxed there.
MMR_MAX_PER_SOURCE_STRUCTURE=4

# Small-to-big retrieval: match a short passage, then let generation read the
# wider section it sits in. Needs CHUNKING_MODE=structure at index time; with
# fixed chunking there are no parent rows and this is a no-op.
PARENT_EXPANSION_ENABLED=true
# Ceiling on a parent block handed to the model, so one section cannot eat the
# whole context budget.
PARENT_MAX_CHARS=1800

# ---- Grounding / abstention ----
ABSTENTION_THRESHOLD=-6.0
# OCR-derived image evidence scores ~6 logits lower, so it gets its own bar.
ABSTENTION_THRESHOLD_IMAGE=-9.0
CITATION_THRESHOLD=0.35
# Refuse when a year the question commits to appears nowhere in the evidence.
COVERAGE_GUARD_ENABLED=true
# Also police every number. Off by default: it refuses legitimate rephrasings
# such as "1.2 million" for "1200000".
COVERAGE_GUARD_ALL_NUMBERS=false
# After generation, caveat any figure the evidence does not contain.
NUMERIC_GUARD_ENABLED=true
NUMERIC_GUARD_MIN_DIGITS=2
# Refuse when the entity the question asks about appears nowhere in the evidence
# but a similar one does ("Project Beta" against a corpus full of Alpha). Runs
# before generation, so the model is never asked - measured refusal: 0.7 s.
ENTITY_GUARD_ENABLED=true
# Judge each retrieved passage, not the whole block: a figure stated for 2023
# does not support an answer about 2024 even when both sit in one section.
TEMPORAL_GUARD_ENABLED=true
# When the question names a period, show the evidence mentioning it first.
# Reorders only - it never rescores, because changing the best score would
# silently re-calibrate the abstention gate.
PERIOD_TARGETING_ENABLED=true
# Collapse a looping generation. Markdown ordinals and locator digits (page and
# timestamp strings) are excluded, so a numbered list is not mistaken for a loop.
REPETITION_GUARD_ENABLED=true
# When the answer names a metric whose value is in the evidence but not in the
# answer, append it labelled as quoted from the evidence - never woven in, and
# never on a lookup question.
SYNTHESIS_COMPLETION_ENABLED=true

# ---- OCR quality ----
# Tesseract reports a confidence per word. Weak words are dropped and weak
# passages are annotated, so the model will not quote figures it cannot see.
OCR_CONFIDENCE_ENABLED=true
OCR_MIN_WORD_CONFIDENCE=40
# Digits get a higher bar: a misread letter reads as noise, a misread digit
# silently becomes a different fact.
OCR_MIN_DIGIT_CONFIDENCE=60
OCR_LOW_CONFIDENCE_THRESHOLD=60
OCR_DIGIT_DROP_RATIO=0.25
# Small screenshots are upscaled toward this size before OCR. Measured on the
# demo dashboard: 63.6% mean confidence at native size vs 90.5% upscaled 2x.
OCR_TARGET_LONGEST_PX=2200
OCR_MAX_UPSCALE=4

# ---- Audio ----
# Local speaker diarization (MFCC + clustering). Degrades gracefully to a
# single speaker when a clip is too short to cluster.
DIARIZATION_ENABLED=true
DIARIZATION_MAX_SPEAKERS=6

# ---- UI ----
# Stream answer tokens instead of one batched block.
STREAMING_ENABLED=true

# ---- Local accounts (UI sign-in gate) ----
# Passwords are PBKDF2-HMAC-SHA256 with a per-user salt in auth\users.db.
# 200k iterations is ~100-200 ms per check on a laptop CPU.
AUTH_PBKDF2_ITERATIONS=200000
AUTH_MIN_PASSWORD_LENGTH=10
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=5

# --- API bearer tokens ---------------------------------------------------
# api.py requires "Authorization: Bearer eai_..." on every endpoint except
# GET /health. Tokens are minted per account and carry that account's role:
#   python scripts\create_user.py --username svc --create-token --label ingest
#   python scripts\create_user.py --list-tokens
#   python scripts\create_user.py --revoke-token eai_AbCdEfGh
# The plaintext is shown once; only its SHA-256 digest is stored. false makes the
# API an open door on whatever interface it is bound to - loopback only, then.
API_AUTH_ENABLED=true

# ---- Ingestion limits ----
# Refuse an upload larger than this rather than filling the disk mid-ingest.
MAX_FILE_BYTES=209715200
# Reject a question longer than this before it reaches a model.
MAX_QUERY_CHARS=2000

# ---- Paths ----
# All three default to folders beside the code, so a checkout is self-contained.
# Moving DATA_DIR also moves the account and history databases: they are derived
# from it (data\..\auth\users.db and data\..\history\chat_history.db), not
# configured separately. INDEX_DIR is the one path that can be set on its own.
#DATA_DIR=C:\EvidenceAI\data
#INDEX_DIR=C:\EvidenceAI\index
#EVALUATION_DIR=C:\EvidenceAI\evaluation

# ---- External binaries ----
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
SOFFICE_CMD=C:\Program Files\LibreOffice\program\soffice.exe

# ---- Offline enforcement (set these to prove no hub access at runtime) ----
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
